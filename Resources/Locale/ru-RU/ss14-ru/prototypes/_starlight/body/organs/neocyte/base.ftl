ent-BaseNeocyteOrgan = { ent-BaseItem }
    .desc = { ent-BaseItem.desc }
ent-OrganNeocyteBrain = кибернетический мозг
    .desc = Источник невероятного, бесконечного интеллекта. 01201020 02102111 01201210 02121012 20121210
    .suffix = Протоген
ent-OrganNeocyteEyes = кибернетические глаза
    .desc = Они всё ещё сфокусированы на вас... Жутко.
    .suffix = Протоген
ent-OrganNeocyteTongue = кибернетический язык
    .desc = Полностью светящийся орган, обычно используемый для лжи или самовыражения. Иногда для обоих.
    .suffix = Протоген
ent-OrganNeocyteTongueForked = раздвоенный кибернетический язык
    .desc = Полностью светящийся орган, обычно используемый для лжи или самовыражения. Иногда для обоих. Теперь разделён надвое.
    .suffix = Протоген
ent-OrganNeocyteEars = кибернетические уши
    .desc = Обрабатывают звук с более высоким качеством, чем у большинства гуманоидов, позволяя лучше ценить техно-музыку.
    .suffix = Протоген
ent-OrganNeocyteLungs = кибернетические лёгкие
    .desc = Фильтруют кислород из атмосферы, который затем направляется в кровоток для использования как переносчик электронов. Полностью кибернетические по природе, работают в паре с системой фильтрации визора.
    .suffix = Протоген
ent-OrganNeocyteHeart = кибернетическое сердце
    .desc = На самом деле не нуждается в биении, просто имитирует движение для комфорта пользователя.
    .suffix = Протоген
ent-OrganNeocyteStomach = биологический реактор
    .desc = Некоторые называют это переусложнённым, но оно жизненно важно для работы протогена. Превращает органику в органическую и электрическую энергию для питания кибернетики и плоти протогена.
    .suffix = Протоген
ent-OrganNeocyteLiver = кибернетическая печень
    .desc = Предложение к подаче: гарнир из ферментированных планок ОЗУ и хороший ЦП.
    .suffix = Протоген
ent-OrganNeocyteKidneys = кибернетические почки
    .desc = Откачивают токсины из кровотока и служат небольшой биологической батареей для электрических компонентов.
    .suffix = Протоген
ent-OrganNeoFelionoidTongue = { ent-OrganNeocyteTongue }
    .desc = { ent-OrganNeocyteTongue.desc }
    .suffix = Нео-фелиноид
ent-OrganNeoVulpkaninTongue = { ent-OrganNeocyteTongue }
    .desc = { ent-OrganNeocyteTongue.desc }
    .suffix = Нео-вульпканин
