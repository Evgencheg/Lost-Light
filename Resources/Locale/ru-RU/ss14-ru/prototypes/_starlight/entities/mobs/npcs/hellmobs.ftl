ent-MobBluespaceHarvesterOtherthing = нечто иное
    .desc = Массивное неуклюжее чудовище. Двигается медленно, но способно выдерживать огромный урон.
    .suffix = { ent-BaseMobBluespaceHarvester.suffix }
