    .desc = { ent-Solution.desc }
ent-PlumbingDrain = Водопроводный слив
    .desc = Напольный слив, который поглощает лужи и направляет их в водопроводную сеть вместо утилизации.
ent-SolutionPlumbingDrainDrainBuffer = { ent-Solution }
    .desc = { ent-Solution.desc }
