# cmd descriptions
command-description-eshuttle-delayshuttledeparture =
    Задерживает отлёт эвакуационных шаттлов на указанное число секунд.
command-description-eshuttle-delayshuttlearrival =
    Задерживает прибытие эвакуационного шаттла на станцию на указанное число секунд.
command-description-eshuttle-dockshuttle =
    Мгновенно стыкует эвакуационный шаттл.
command-description-eshuttle-callshuttle =
    Вызывает эвакуационный шаттл с необязательным временем прибытия.
command-description-eshuttle-recallshuttle =
    Отзывает эвакуационный шаттл.
command-description-eshuttle-allowshuttlecalls =
    Разрешает или запрещает вызов эвакуационного шаттла.
command-description-eshuttle-launchshuttle =
    Досрочно отправляет эвакуационный шаттл. Работает только после стыковки со станцией.

# messages
delayemergencyshuttledeparture-message =
    Все запуски эвакуационных шаттлов отложены на { $seconds } с.
delayemergencyshuttlearrival-message =
    Все прибытия эвакуационных шаттлов отложены на { $seconds } с.
